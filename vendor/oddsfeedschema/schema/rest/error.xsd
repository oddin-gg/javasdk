<?xml version="1.0" encoding="UTF-8"?>
<!--
    The body every REST endpoint returns with a non-2xx status code. Previously
    undeclared, although all three SDKs decode it.
-->
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="response" type="errorResponse"/>
    <xs:complexType name="errorResponse">
        <xs:sequence>
            <xs:element type="xs:string" name="action" minOccurs="0"/>
            <xs:element type="xs:string" name="message" minOccurs="0"/>
        </xs:sequence>
        <!--
            The underscored HTTP status text, e.g. NOT_FOUND. Deliberately not the
            response_code enumeration: the envelope can carry any status text the
            API returns, including ones the enumeration does not list.
        -->
        <xs:attribute type="xs:string" name="response_code" use="required"/>
    </xs:complexType>
</xs:schema>
