<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gg.oddin.oddsfeed</groupId>
    <artifactId>odds-feed-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>test-fakes</artifactId>
  <packaging>jar</packaging>

  <name>Oddin Odds Feed SDK test fakes</name>
  <description>
    The fake REST API and the fake feed the SDK's own tests and the system tests run against,
    answering and publishing from the vendored schema fixtures. It adds nothing the SDK itself uses -
    no AMQP client, no XML binding - so the system tests can use it with the 0.0.x SDK as well as
    with 1.0: the feed is a real broker in a container, published to over its management API.
  </description>

  <properties>
    <!-- For tests only. Nothing here is published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <!--
      Runs the message broker behind the fake feed. The exclusion keeps the SDK's own classpath as
      it was published: without it, the newer copy Testcontainers brings would replace the one
      the SDK depends on.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.jetbrains</groupId>
          <artifactId>annotations</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <!-- testcontainers.properties: the helper images, pinned -->
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <!-- the fixtures vendored from the oddsfeedschema repository, see vendor/oddsfeedschema/SOURCE -->
        <directory>${project.basedir}/../vendor/oddsfeedschema/test/fixtures</directory>
        <targetPath>oddsfeedschema/test/fixtures</targetPath>
      </resource>
    </resources>
  </build>
</project>
