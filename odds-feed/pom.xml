<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gg.oddin.oddsfeed</groupId>
    <artifactId>odds-feed-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>odds-feed</artifactId>
  <packaging>jar</packaging>

  <name>Oddin Odds Feed SDK</name>
  <description>Java SDK for the Oddin odds feed.</description>

  <properties>
    <!--
      The release whose public API this one keeps source-compatible. PublicShapeTest reads its jar
      from the local repository, where scripts/fetch-sdk.sh puts it after checking its digest, and
      compares every public type against it. It is never put on a classpath: its classes have the
      same names as ours.
    -->
    <api.baseline.groupPath>com/oddin/oddsfeed</api.baseline.groupPath>
    <api.baseline.version>0.0.57</api.baseline.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        The Jakarta XML Binding API and its reference runtime, in versions made for each other.
        Imported here, not in the parent: the system tests run the 0.0.x SDK on the javax runtime,
        and a parent import would move that runtime's own dependencies to these versions.
      -->
      <dependency>
        <groupId>org.glassfish.jaxb</groupId>
        <artifactId>jaxb-bom</artifactId>
        <version>${jaxb.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      Nullness annotations. The 0.0.x line was Kotlin, and Kotlin callers read its nullability from
      the metadata; these carry the same information, so a Kotlin client sees the same types.
    -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>

    <!-- The feed and REST XML classes are Jakarta XML Binding classes; the runtime decodes them. -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- the caches: bounded, with ages, no soft references (NEXT.md, Caches and loaders) -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- the feed's broker -->
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
      <version>${amqp-client.version}</version>
    </dependency>

    <!--
      The XML parser JAXB reads with: about three times the JDK's own, and with its own limits. It
      ships inside the jar, relocated, and is optional here so clients do not get a copy of their own:
      on the classpath, Woodstox registers itself as every application's StAX parser, and ignores the
      JDK's XML hardening properties the application may rely on.
    -->
    <dependency>
      <groupId>com.fasterxml.woodstox</groupId>
      <artifactId>woodstox-core</artifactId>
      <version>${woodstox.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>


    <dependency>
      <!-- the old examples import it; ApiUsageTest compiles them -->
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the fake REST API -->
      <groupId>gg.oddin.oddsfeed</groupId>
      <artifactId>test-fakes</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <!-- the SDK's version, written into the jar for the telemetry; see SdkVersion -->
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>com/oddin/oddsfeedsdk/internal/sdk.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>com/oddin/oddsfeedsdk/internal/sdk.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <!-- the vendored schema and fixtures, for the golden tests; see vendor/oddsfeedschema/SOURCE -->
        <directory>${project.basedir}/../vendor/oddsfeedschema</directory>
        <targetPath>oddsfeedschema</targetPath>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <!--
          Generates the feed and REST XML classes from the vendored schema at every build; nothing
          generated is committed. src/main/xjb keeps the 0.0.x class names and interfaces.
        -->
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
        <version>${jaxb-maven-plugin.version}</version>
        <configuration>
          <extension>true</extension>
          <noFileHeader>true</noFileHeader>
          <episode>false</episode>
          <args>
            <arg>-Xinheritance</arg>
            <arg>-Xinject-code</arg>
            <!-- Boolean getters as getX(), which is what 0.0.x had -->
            <arg>-enableIntrospection</arg>
          </args>
          <plugins>
            <plugin>
              <groupId>org.jvnet.jaxb</groupId>
              <artifactId>jaxb-plugins</artifactId>
              <version>${jaxb-maven-plugin.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>feed</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <schemaDirectory>${project.basedir}/../vendor/oddsfeedschema/schema/feed</schemaDirectory>
              <schemaIncludes>
                <include>*.xsd</include>
              </schemaIncludes>
              <bindingDirectory>${project.basedir}/src/main/xjb</bindingDirectory>
              <bindingIncludes>
                <include>feed.xjb</include>
              </bindingIncludes>
              <generateDirectory>${project.build.directory}/generated-sources/xjc-feed</generateDirectory>
            </configuration>
          </execution>
          <execution>
            <id>rest</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <schemaDirectory>${project.basedir}/../vendor/oddsfeedschema/schema/rest</schemaDirectory>
              <schemaIncludes>
                <include>*.xsd</include>
              </schemaIncludes>
              <bindingDirectory>${project.basedir}/src/main/xjb</bindingDirectory>
              <bindingIncludes>
                <include>rest.xjb</include>
              </bindingIncludes>
              <generateDirectory>${project.build.directory}/generated-sources/xjc-rest</generateDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- the published POM is the flattened one, where the parser is optional -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.fasterxml.woodstox:woodstox-core</include>
                  <include>org.codehaus.woodstox:stax2-api</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.ctc.wstx</pattern>
                  <shadedPattern>com.oddin.oddsfeedsdk.internal.woodstox.wstx</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.codehaus.stax2</pattern>
                  <shadedPattern>com.oddin.oddsfeedsdk.internal.woodstox.stax2</shadedPattern>
                  <excludes>
                    <!-- property names JAXB asks the parser for: renamed, it would intern every name itself -->
                    <exclude>org.codehaus.stax2.internNames</exclude>
                    <exclude>org.codehaus.stax2.internNsUris</exclude>
                  </excludes>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <!-- no service registration: the SDK names its parser, and the application keeps its own -->
                  <!-- its Maven metadata stays: dependency scanners find a bundled Woodstox by it -->
                  <artifact>com.fasterxml.woodstox:woodstox-core</artifact>
                  <excludes>
                    <exclude>META-INF/services/**</exclude>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.codehaus.woodstox:stax2-api</artifact>
                  <excludes>
                    <exclude>META-INF/services/**</exclude>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- ShadedJarIT reads the packaged jar, so it runs after the shading, as an integration test -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <shaded.jar>${project.build.directory}/${project.build.finalName}.jar</shaded.jar>
            <published.pom>${project.basedir}/.flattened-pom.xml</published.pom>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs combine.children="append">
            <!-- Woodstox's classes carry an OSGi annotation whose jar they do not bring along -->
            <arg>-Xlint:-classfile</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <baseline.jar>${settings.localRepository}/${api.baseline.groupPath}/odds-feed/${api.baseline.version}/odds-feed-${api.baseline.version}.jar</baseline.jar>
            <baseline.version>${api.baseline.version}</baseline.version>
            <!-- SdkVersionTest checks the jar reports the version it was built as -->
            <sdk.built.version>${project.version}</sdk.built.version>
            <examples.sources>${maven.multiModuleProjectDirectory}/examples/src/main/java</examples.sources>
            <!-- the same pins the system tests check the SDK they run against with -->
            <baseline.checksums>${maven.multiModuleProjectDirectory}/system-tests/src/test/resources/sdk-jar-checksums.properties</baseline.checksums>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <!--
          verify fails when the unit tests cover less than this. The floor sits just under what the
          tests covered when it was set (lines 81.6%, branches 75.5%); raise it as coverage grows.
          The two schema packages are left out: nearly all of them is generated, and a schema bump
          would move the number without a line of ours changing.
        -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>com/oddin/oddsfeedsdk/schema/feed/v1/**</exclude>
                <exclude>com/oddin/oddsfeedsdk/schema/rest/v1/**</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.81</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
