<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gg.oddin.oddsfeed</groupId>
    <artifactId>odds-feed-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>system-tests</artifactId>
  <packaging>jar</packaging>

  <name>Oddin Odds Feed SDK system tests</name>
  <description>
    Black-box tests that drive the SDK through its public API only, against a fake feed and a fake REST API.
    They run unchanged against the old 0.0.x SDK and the new 1.0 SDK: the published 0.0.x by default,
    the one this build makes with -Dsdk.next.
  </description>

  <properties>
    <!-- Not a library. Nothing here is published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <repositories>
    <!--
      Central is named first on purpose. A repository declared in a POM is searched before the
      one Maven inherits, so without this entry every junit/assertj/logback lookup would go to
      the packages registry first and anyone able to publish there could shadow a public
      artifact. In this order only odds-feed, which Central does not have, falls through.

      Note the other direction: Central is asked for odds-feed first as well. The 0.0.x group id
      is com.oddin.oddsfeed, which we cannot claim on Central - it is verified against a domain
      that is not ours - so this cannot be closed by registering it. BuildWiringIT pins the jar
      and POM digests instead, and CI fetches both from the registry before Maven resolves
      anything. 1.0 publishes under gg.oddin.oddsfeed, which we can claim, and the question
      goes away with it.
    -->
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <!--
      Published 0.0.x releases live in GitHub Packages, which needs a token even for reads.
      Declared here, not in the parent, so it covers only the module that needs it.
      Locally: a <server> with id "oddin-github" in ~/.m2/settings.xml, the same id the client setup guide uses (any GitHub token with read:packages).
      CI: setup-java writes the same server entry from GITHUB_TOKEN.
    -->
    <repository>
      <id>oddin-github</id>
      <url>https://maven.pkg.github.com/oddin-gg/javasdk</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- The SDK under test, resolved by coordinate: see sdk.groupId and sdk.version. -->
    <dependency>
      <groupId>${sdk.groupId}</groupId>
      <artifactId>odds-feed</artifactId>
      <version>${sdk.version}</version>
    </dependency>

    <dependency>
      <!-- the fake REST API -->
      <groupId>gg.oddin.oddsfeed</groupId>
      <artifactId>test-fakes</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Runs the message broker behind the fake feed. The exclusion keeps the SDK's own classpath as
      it was published: without it, the newer copy Testcontainers brings would replace the one
      the SDK depends on.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.jetbrains</groupId>
          <artifactId>annotations</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <!--
          The schema and fixtures vendored from the oddsfeedschema repository, see
          vendor/oddsfeedschema/SOURCE. Tests read them from the classpath under oddsfeedschema/;
          the build never fetches them from anywhere.
        -->
        <directory>${project.basedir}/../vendor/oddsfeedschema</directory>
        <targetPath>oddsfeedschema</targetPath>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Nothing to run until the first scenarios land. -->
          <failIfNoTests>false</failIfNoTests>
          <systemPropertyVariables>
            <!-- KnownDifferenceListTest reads KNOWN-DIFFERENCES.md next to this POM. -->
            <module.basedir>${project.basedir}</module.basedir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <!--
          Scenarios that need a container or a fake server are named *IT and run in the
          integration-test phase. Without this execution failsafe is versioned but never
          runs, and `verify` would pass while skipping every one of them.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- BuildWiringIT reads both POMs; the working directory alone would not say which. -->
            <module.basedir>${project.basedir}</module.basedir>
            <root.basedir>${maven.multiModuleProjectDirectory}</root.basedir>
            <project.version>${project.version}</project.version>
            <sdk.version>${sdk.version}</sdk.version>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- Tests only; there is no jar worth building. -->
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        The 0.0.x jar targets Java 8 and uses javax.xml.bind, which modern JDKs no longer ship.
        This lets the old SDK run on the JDK 25 toolchain.
        The API comes with the runtime (jakarta.xml.bind-api, which still holds the javax.xml.bind
        classes); adding javax.xml.bind:jaxb-api on top would put two copies of the same package
        on the classpath and leave the winner to classpath order. BuildWiringIT checks there is one.
        The old line only: declared here, it is nearer than the 4.0 runtime 1.0 brings and would
        replace it, leaving 1.0 without a Jakarta runtime. The parent's sdk-next profile has the
        other half of the switch.
      -->
      <id>legacy-sdk</id>
      <activation>
        <property>
          <name>!sdk.next</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.glassfish.jaxb</groupId>
          <artifactId>jaxb-runtime</artifactId>
          <version>2.3.9</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
