<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.oddin.oddsfeed</groupId>
    <artifactId>odds-feed-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>system-tests</artifactId>
  <packaging>jar</packaging>

  <name>Oddin Odds Feed SDK system tests</name>
  <description>
    Black-box tests that drive the SDK through its public API only, against a fake feed and a fake REST API.
    They run unchanged against the old 0.0.x SDK and the new 1.0 SDK; the version is the sdk.version property.
  </description>

  <properties>
    <!-- Not a library. Nothing here is published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <repositories>
    <!--
      Central is named first on purpose. A repository declared in a POM is searched before the
      one Maven inherits, so without this entry every junit/assertj/logback lookup would go to
      the packages registry first and anyone able to publish there could shadow a public
      artifact. In this order only odds-feed, which Central does not have, falls through.

      Note the other direction: Central is asked for odds-feed first as well, and that holds only
      while nobody else can publish com.oddin.oddsfeed there. Nothing is published under that
      namespace today, so it has to be registered before the 1.0 release - which releasing to
      Central needs anyway.
    -->
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <!--
      Published 0.0.x releases live in GitHub Packages, which needs a token even for reads.
      Declared here, not in the parent, so it covers only the module that needs it.
      Locally: a <server> with id "oddin-github" in ~/.m2/settings.xml, the same id the client setup guide uses (any GitHub token with read:packages).
      CI: setup-java writes the same server entry from GITHUB_TOKEN.
    -->
    <repository>
      <id>oddin-github</id>
      <url>https://maven.pkg.github.com/oddin-gg/javasdk</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- The SDK under test, resolved by coordinate. -->
    <dependency>
      <groupId>com.oddin.oddsfeed</groupId>
      <artifactId>odds-feed</artifactId>
      <version>${sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      The 0.0.x jar targets Java 8 and uses javax.xml.bind, which modern JDKs no longer ship.
      This lets the old SDK run on the JDK 25 toolchain. It is harmless for the new SDK, and
      Maven 3 cannot switch it on by version prefix, so it stays unconditional.
      The API comes with the runtime (jakarta.xml.bind-api, which still holds the javax.xml.bind
      classes); adding javax.xml.bind:jaxb-api on top would put two copies of the same package
      on the classpath and leave the winner to classpath order. BuildWiringIT checks there is one.
    -->
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>2.3.9</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Nothing to run until the first scenarios land. -->
          <failIfNoTests>false</failIfNoTests>
        </configuration>
      </plugin>
      <plugin>
        <!--
          Scenarios that need a container or a fake server are named *IT and run in the
          integration-test phase. Without this execution failsafe is versioned but never
          runs, and `verify` would pass while skipping every one of them.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- BuildWiringIT reads both POMs; the working directory alone would not say which. -->
            <module.basedir>${project.basedir}</module.basedir>
            <root.basedir>${maven.multiModuleProjectDirectory}</root.basedir>
            <project.version>${project.version}</project.version>
            <sdk.version>${sdk.version}</sdk.version>
            <build.timestamp>${maven.build.timestamp}</build.timestamp>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- Tests only; there is no jar worth building. -->
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
