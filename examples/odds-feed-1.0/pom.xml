<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>gg.oddin.oddsfeed</groupId>
    <artifactId>odds-feed-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>odds-feed-examples</artifactId>
  <packaging>jar</packaging>

  <name>Oddin Odds Feed SDK 1.0 examples</name>
  <description>
    Small runnable examples of the 1.0 SDK. The build only compiles them: running one needs a token.
    The examples of 0.0.x are in the Gradle project one directory up.
  </description>

  <properties>
    <!-- Not a library. Nothing here is published. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <!-- a client writes the version it uses here; the build uses the one it builds -->
    <dependency>
      <groupId>gg.oddin.oddsfeed</groupId>
      <artifactId>odds-feed</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <!-- the SLF4J backend: the SDK logs through SLF4J and brings none -->
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- puts the jar of the SDK this build made, and what it needs, into target/lib to run the examples from -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>copy-runtime-classpath</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
