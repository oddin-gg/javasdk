{
  "jobs": {
    "build": {
      "name": "Build and test",
      "needs": "check",
      "permissions": {
        "contents": "read",
        "packages": "read"
      },
      "uses": "./.github/workflows/next.yml",
      "with": {
        "revision": "${{ needs.check.outputs.version }}"
      }
    },
    "check": {
      "name": "Check the tag",
      "outputs": {
        "commit": "${{ steps.tag.outputs.commit }}",
        "final": "${{ steps.tag.outputs.final }}",
        "version": "${{ steps.tag.outputs.version }}"
      },
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
          "with": {
            "fetch-depth": 0,
            "persist-credentials": false
          }
        },
        {
          "id": "tag",
          "name": "Check the tag",
          "run": "./scripts/release-check.sh \"$GITHUB_REF_NAME\""
        }
      ]
    },
    "github-release": {
      "if": "${{ !cancelled() && needs.publish.result == 'success' }}",
      "name": "GitHub Release",
      "needs": [
        "check",
        "publish"
      ],
      "permissions": {
        "contents": "write"
      },
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
          "with": {
            "persist-credentials": false,
            "ref": "${{ needs.check.outputs.commit }}"
          }
        },
        {
          "env": {
            "COMMIT": "${{ needs.check.outputs.commit }}"
          },
          "name": "Check the tag still names the published commit",
          "run": "./scripts/release-tag-check.sh \"$GITHUB_REF_NAME\" \"$COMMIT\""
        },
        {
          "name": "Fetch the published bundle",
          "uses": "actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093",
          "with": {
            "name": "central-bundle"
          }
        },
        {
          "env": {
            "FINAL": "${{ needs.check.outputs.final }}",
            "GH_REPO": "${{ github.repository }}",
            "GH_TOKEN": "${{ github.token }}",
            "VERSION": "${{ needs.check.outputs.version }}"
          },
          "name": "Create the release",
          "run": "unzip -q central-bundle.zip -d bundle\ndir=bundle/gg/oddin/oddsfeed/odds-feed/$VERSION\nfiles=()\nfor name in \"odds-feed-$VERSION.jar\" \"odds-feed-$VERSION.pom\"; do\n  for file in \"$dir/$name\" \"$dir/$name.asc\"; do\n    if [ ! -s \"$file\" ]; then\n      echo \"the bundle has no $file\" >&2\n      exit 1\n    fi\n    files+=(\"$file\")\n  done\ndone\nprerelease=()\nif [ \"$FINAL\" != \"true\" ]; then\n  prerelease=(--prerelease)\nfi\ngh release create \"$GITHUB_REF_NAME\" --verify-tag --title \"$VERSION\" \\\n  --notes-file \"release-notes/$VERSION.md\" \"${prerelease[@]}\" \"${files[@]}\"\n"
        }
      ],
      "timeout-minutes": 15
    },
    "publish": {
      "concurrency": {
        "cancel-in-progress": false,
        "group": "maven-central-${{ github.ref_name }}"
      },
      "environment": "maven-central",
      "name": "Sign and publish to Maven Central",
      "needs": [
        "check",
        "build"
      ],
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
          "with": {
            "persist-credentials": false,
            "ref": "${{ needs.check.outputs.commit }}"
          }
        },
        {
          "env": {
            "CENTRAL_TOKEN_PASSWORD": "${{ secrets.CENTRAL_TOKEN_PASSWORD }}",
            "CENTRAL_TOKEN_USERNAME": "${{ secrets.CENTRAL_TOKEN_USERNAME }}",
            "MAVEN_GPG_KEY": "${{ secrets.MAVEN_GPG_KEY }}",
            "MAVEN_GPG_PASSPHRASE": "${{ secrets.MAVEN_GPG_PASSPHRASE }}"
          },
          "id": "secrets",
          "name": "Check the secrets are set",
          "run": "missing=0\nfor name in CENTRAL_TOKEN_USERNAME CENTRAL_TOKEN_PASSWORD MAVEN_GPG_KEY MAVEN_GPG_PASSPHRASE; do\n  if [ -z \"${!name}\" ]; then\n    echo \"secret $name is not set in the maven-central environment\" >&2\n    missing=1\n  fi\ndone\nexit $missing\n"
        },
        {
          "name": "Set up JDK 25",
          "uses": "actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3",
          "with": {
            "distribution": "corretto",
            "java-version": "25",
            "server-id": "central",
            "server-password": "CENTRAL_TOKEN_PASSWORD",
            "server-username": "CENTRAL_TOKEN_USERNAME"
          }
        },
        {
          "env": {
            "COMMIT": "${{ needs.check.outputs.commit }}"
          },
          "name": "Check the tag still names this commit",
          "run": "./scripts/release-tag-check.sh \"$GITHUB_REF_NAME\" \"$COMMIT\""
        },
        {
          "env": {
            "CENTRAL_TOKEN_PASSWORD": "${{ secrets.CENTRAL_TOKEN_PASSWORD }}",
            "CENTRAL_TOKEN_USERNAME": "${{ secrets.CENTRAL_TOKEN_USERNAME }}",
            "MAVEN_GPG_KEY": "${{ secrets.MAVEN_GPG_KEY }}",
            "MAVEN_GPG_PASSPHRASE": "${{ secrets.MAVEN_GPG_PASSPHRASE }}",
            "VERSION": "${{ needs.check.outputs.version }}"
          },
          "id": "upload",
          "name": "Sign and publish",
          "run": "./mvnw --batch-mode --no-transfer-progress -Prelease -Drevision=\"$VERSION\" -Dcentral.autoPublish=true -Dcentral.waitUntil=published -DskipTests -pl odds-feed -am deploy"
        },
        {
          "name": "Keep the published bundle",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "if-no-files-found": "error",
            "name": "central-bundle",
            "path": "target/central-publishing/central-bundle.zip"
          }
        }
      ],
      "timeout-minutes": 90
    }
  },
  "name": "Java SDK 1.0 release",
  "on": {
    "push": {
      "tags": [
        "v1.*"
      ]
    }
  },
  "permissions": {
    "contents": "read"
  }
}
